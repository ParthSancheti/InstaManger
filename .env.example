# ============================================================
# STOCK WARRIOR — SECRETS (copy to .env and fill in)
# prompts_store.json is secret-free — EVERYTHING private lives here.
# ============================================================

# --- Telegram (REQUIRED — the control panel + channel publishing) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# --- Meta / Instagram Graph API v25.0 (posting only — optional) ---
META_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# --- YouTube Shorts (optional — also needs yt_token.json OAuth file) ---
# no key here; put your OAuth user credentials in yt_token.json

# --- Reddit Growth Hacker (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- X / Twitter (optional) ---
# The bearer token is APP-ONLY auth: it can READ (trend capture) but CANNOT POST.
TWITTER_BEARER_TOKEN=
# Posting needs OAuth 1.0a user context. Create these in the X developer portal
# with Read+Write permission, then set settings.twitter_enabled = true.
# Until all four are filled, Twitter routing stays dark and is simply skipped.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Media APIs (Image hosting / Stock video) ---
IMGBB_API_KEY=
PEXELS_API_KEY=
