# ============================================================
# STOCK WARRIOR — SECRETS (copy to .env and fill in)
# prompts_store.json is secret-free — EVERYTHING private lives here.
# ============================================================

# --- Telegram (REQUIRED — the control panel + channel publishing) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# --- Meta / Instagram Graph API v25.0 (posting only — optional) ---
META_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# --- YouTube Shorts (optional — also needs yt_token.json OAuth file) ---
# no key here; put your OAuth user credentials in yt_token.json

# --- Reddit Growth Hacker (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- X / Twitter (optional) ---
# The bearer token is APP-ONLY auth: it can READ (trend capture) but CANNOT POST.
TWITTER_BEARER_TOKEN=
# Posting needs OAuth 1.0a user context. Create these in the X developer portal
# with Read+Write permission, then set settings.twitter_enabled = true.
# Until all four are filled, Twitter routing stays dark and is simply skipped.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Media APIs (Image hosting / Stock video) ---
# ImgBB — free image host. Meta downloads media from a PUBLIC url, so without
# this, image publishing falls back to anonymous hosts that get rate-limited.
# Get a key free at https://api.imgbb.com/
IMGBB_API_KEY=

# Pexels — free stock FOOTAGE (b-roll) used as the moving background behind the
# news banner in Story clips. It is a SOURCE of video, not a host: it cannot
# serve your own rendered mp4 to Meta. Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Direct upload: the real fix for video -------------------------------
# The Graph API never receives a file — it DOWNLOADS media from a public URL.
# ImgBB hosts images only, and no free anonymous host is dependable for video,
# which is why photo posts succeed while Reels and Stories fail.
#
# With these set, Reels and Stories are POSTED DIRECTLY through Instagram's
# private mobile API (instagrapi) when Graph fails — no hosting involved.
#   pip install instagrapi
#
# Caveat: unofficial API. Instagram may raise a login challenge (approve it on
# your phone). A session is cached in ig_session.json so you don't log in
# repeatedly, which is what usually triggers challenges.
IG_USERNAME=
IG_PASSWORD=
